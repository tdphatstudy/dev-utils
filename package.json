{
  "name": "devfusion",
  "productName": "DevFusion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cross-platform local developer toolbox",
  "main": "./out/main/index.js",
  "author": "DevFusion",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui:enterprise": "node tests/enterprise-ui.smoke.mjs && node tests/vault-lock-ui.smoke.mjs && node tests/advanced-tools-ui.smoke.mjs",
    "test:ui:security-testing": "node tests/security-testing-ui.smoke.mjs",
    "test:ui:i18n": "node tests/i18n-ui.smoke.mjs",
    "test:electron:security": "node tests/electron-security.smoke.mjs",
    "test:electron:packaged": "node tests/electron-security.smoke.mjs --packaged",
    "verify:package": "node scripts/verify-package.mjs",
    "dist:win:signed": "pnpm run build && electron-builder --win --config electron-builder.signed.yml --publish never",
    "dist:mac:signed": "pnpm run build && electron-builder --mac --config electron-builder.signed.yml --publish never",
    "postinstall": "electron-builder install-app-deps",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder --win --linux",
    "dist:win": "pnpm run build && electron-builder --win -c.win.signAndEditExecutable=false",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "dist:dir": "pnpm run build && electron-builder --dir"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "electron-winstaller"
    ]
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@uiw/react-codemirror": "^4.23.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.475.0",
    "node-sql-parser": "^5.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.29.0",
    "sql-formatter": "^15.8.2",
    "tailwind-merge": "^2.6.0",
    "yaml": "^2.7.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/vie": "1.0.0",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.5.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "pdfjs-dist": "6.4.299",
    "pe-library": "^2.0.1",
    "playwright": "1.63.0",
    "postcss": "^8.5.2",
    "resedit": "^3.0.2",
    "tailwindcss": "^3.4.17",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^3.0.5"
  }
}
